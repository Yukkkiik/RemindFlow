# Database connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/remindflow"

# Authentication secret for signing session JWTs. WAJIB diisi.
# PERINGATAN: jangan pakai nilai contoh dan jangan commit nilai asli.
# Server menolak start jika kosong (dan di production jika < 32 karakter).
# Buat dengan: openssl rand -base64 32
JWT_SECRET=""

# Demo account for `npm run db:seed` (password minimal 8 karakter)
DEMO_EMAIL="demo@remindflow.local"
DEMO_PASSWORD=""

# Default Timezone
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Jakarta"
